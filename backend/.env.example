# Copy to backend/.env and supply deployment-specific values.
APP_NAME=RailOpt AI API
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL is the primary backend; keep credentials in environment/secrets, never source.
DATABASE_URL=postgresql+psycopg2://localhost:5432/railopt_ai
DATABASE_ECHO=false
AUTO_CREATE_SQLITE_SCHEMA=true

# Paths are resolved relative to the repository root unless absolute paths are given.
MODEL_PATH=outputs/models/best_model.pkl
FEATURE_COLUMNS_PATH=outputs/models/feature_columns.pkl
SCALER_PATH=outputs/models/scaler.pkl
ENCODERS_DIR=outputs/models/encoders

# Comma-separated exact frontend origins; avoid wildcard origins with credentials enabled.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
MAX_BATCH_SIZE=500
SOLVER_TIME_LIMIT_SECONDS=30

# Seed scripts require an explicit secret; set through a secret manager in production.
ADMIN_NAME=RailOpt Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
